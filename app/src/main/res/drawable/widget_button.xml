<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true"><shape><corners android:radius="18dp" /><solid android:color="#50FFFFFF" /><stroke android:width="1dp" android:color="#88FFFFFF" /></shape></item>
    <item android:state_focused="true"><shape><corners android:radius="18dp" /><solid android:color="#24FFFFFF" /><stroke android:width="2dp" android:color="#FFFFFFFF" /></shape></item>
    <item><shape><corners android:radius="18dp" /><gradient android:angle="270" android:startColor="#1EFFFFFF" android:endColor="#0AFFFFFF" /><stroke android:width="1dp" android:color="#28FFFFFF" /></shape></item>
</selector>
