<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true"><shape><corners android:radius="18dp" /><solid android:color="#FFFFFFFF" /><stroke android:width="1dp" android:color="#FFFFFFFF" /></shape></item>
    <item android:state_focused="true"><shape><corners android:radius="18dp" /><solid android:color="#EEFFFFFF" /><stroke android:width="2dp" android:color="#FFFFFFFF" /></shape></item>
    <item><shape><corners android:radius="18dp" /><gradient android:angle="270" android:startColor="#F2FFFFFF" android:endColor="#D6E9EDF2" /><stroke android:width="1dp" android:color="#FFFFFFFF" /></shape></item>
</selector>
